# ============================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copiar este archivo a  .env  y rellenar con valores reales.
#  El archivo  .env  NUNCA se sube a git (está en .gitignore).
# ============================================================================

# --- Proveedor del LLM -------------------------------------------------------
# Valores admitidos: deepseek | openai
LLM_PROVIDER=deepseek
# API key del proveedor elegido
LLM_API_KEY=
# Modelo de chat. Ej: deepseek-chat  (DeepSeek)  |  gpt-4o-mini  (OpenAI)
LLM_MODEL=deepseek-chat

# --- Embeddings para el RAG ------------------------------------------------
# local  = se calculan en tu PC con fastembed (sin coste, descarga ~130 MB la 1a vez)
# openai = usa la API de OpenAI (requiere LLM_PROVIDER=openai o una OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
# Solo si EMBEDDING_PROVIDER=openai y el proveedor de chat NO es openai:
OPENAI_API_KEY=

# --- SQL Server (contenedor Docker) --------------------------------------
# Contraseña del usuario 'sa' que usará el contenedor (docker-compose la lee de aquí).
# Requisitos: >= 8 caracteres con mayúscula, minúscula, número y símbolo.
# Solo se usa para administrar el contenedor y restaurar la BD; el agente NO la usa.
MSSQL_SA_PASSWORD=

SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DB=AdventureWorksLT
# Usuario de SOLO LECTURA creado en sql/01_crear_usuario_readonly.sql
SQL_SERVER_USER=agente_readonly
SQL_SERVER_PASSWORD=
# Nombre exacto del driver ODBC instalado en el PC
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Vector store ----------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Guardarraíles / límites --------------------------------------------
# Nº máximo de filas que puede devolver una consulta SQL
SQL_MAX_ROWS=100
# Timeout (segundos) de ejecución de cada consulta SQL
SQL_QUERY_TIMEOUT=10

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/agente.log
